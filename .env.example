AUTH_MODE=local
RUN_MIGRATIONS=true
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_AUTH_MODE=local
