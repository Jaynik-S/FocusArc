# Backend
POSTGRES_USER=coursetimers
POSTGRES_PASSWORD=coursetimers
POSTGRES_DB=coursetimers
# Local Compose only. Never use this URL for hosted deployments.
DATABASE_URL=postgresql+psycopg://coursetimers:coursetimers@db:5432/coursetimers
APP_ENV=dev
RUN_MIGRATIONS=true
CORS_ORIGINS=http://localhost:5173
SESSION_SECRET=local-development-only-change-in-production
SESSION_MAX_AGE_SECONDS=604800
LOG_LEVEL=info

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
